{
  "expo": {
    "name": "metro-scanner-app",
    "slug": "metro-scanner-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần quyền truy cập Camera để quét mã vé."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng cần vị trí để xác định Ga hiện tại."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
